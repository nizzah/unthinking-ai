  << /K [ 8621 0 R ]
     /P 10187 0 R
     /S /P
     /Pg 4945 0 R
     /Type /StructElem
  >>
endobj

8623 0 obj
  << /ActualText (Jade\031s  journey\n\nJade is thinking about starting a podcast\054 she is chatting to a friend when an idea clicks\056 It gives her an idea for a potential episode\056 \n\nShe quickly captures the idea in her notebook and her digital apps\056 There is relief in getting it out of her head and it feels safe and stored somewhere\056 \n\nThe next week\054 she sits down to work on her podcast plan\056 But the excitement is gone\056 She feels overwhelmed\056\n\nShe tries to find the idea\054 scrolling through notes\054 switching between tools\056 It\031s there somewhere\054 but not in a way she can use\056 Her messy and ridged system feels like a place where her ideas go to die\056 \n\nDoubt creeps in\054 maybe it wasn\031t a good idea\056 Maybe she\031s not ready\056 \n\nShe waits for a sign or validation from others to know that it\031s worth pursuing\056\n\nShe goes into the downward spiral of overthinking\054 routine\054 adding to idea graveyard\054 instead of doing the one thing that would help her\056)
     /K [ 1843 ]
     /P 8624 0 R
     /Pg 4945 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

